# ============================================================
# Environment template — KHÔNG ghi secret thật vào đây.
# Dùng: cp .env.example .env  rồi điền giá trị thật.
# File .env đã nằm trong .gitignore — tuyệt đối không commit.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development

# Security — API key cho header X-API-Key (đặt giá trị ngẫu nhiên, mạnh)
AGENT_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# Rate limiting — số request tối đa mỗi API key trong 60 giây
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD) — dùng ít nhất một trong hai
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
